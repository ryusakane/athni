{
  // Cloudflare Workers config: serves the static export in ./out (npm run build).
  "name": "athni",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // PR builds run `wrangler preview`, which requires this block (it can stay empty).
  "previews": {}
}
